{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SeniorMode engineering decision record",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "category", "summary", "aliases", "decisions", "checks", "sources"],
  "properties": {
    "id": {"$ref": "#/definitions/slug"},
    "title": {"type": "string", "minLength": 8, "maxLength": 90},
    "category": {"enum": ["algorithms", "architecture", "backend", "concurrency", "data", "frontend", "geospatial", "networking", "performance", "product", "reliability", "security", "testing"]},
    "summary": {"type": "string", "minLength": 36, "maxLength": 180},
    "aliases": {"type": "array", "minItems": 2, "maxItems": 12, "uniqueItems": true, "items": {"type": "string", "minLength": 2, "maxLength": 70}},
    "decisions": {
      "type": "array",
      "minItems": 2,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["when", "use", "tradeoff"],
        "properties": {
          "when": {"type": "string", "minLength": 12},
          "use": {"type": "string", "minLength": 18},
          "tradeoff": {"type": "string", "minLength": 12}
        }
      }
    },
    "checks": {"type": "array", "minItems": 2, "maxItems": 6, "uniqueItems": true, "items": {"type": "string", "minLength": 18}},
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "url"],
        "properties": {
          "title": {"type": "string", "minLength": 5},
          "url": {"type": "string", "pattern": "^https://[^\\s]+$"}
        }
      }
    },
    "related": {"type": "array", "maxItems": 8, "uniqueItems": true, "items": {"$ref": "#/definitions/slug"}}
  },
  "definitions": {
    "slug": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$", "maxLength": 70}
  }
}
